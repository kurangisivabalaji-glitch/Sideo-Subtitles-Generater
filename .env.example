# ==============================================================================
# Universal AI Video Subtitle Generator — Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false

# Database Configuration
# Local SQLite fallback: sqlite:///./subtitles.db
# PostgreSQL: postgresql://subtitle_user:password@localhost:5432/subtitle_platform
DATABASE_URL=postgresql://subtitle_user:subtitle_password_secure@localhost:5432/subtitle_platform

# Redis Configuration (Job Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Configuration
# Generate a strong 64-character secret key: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-very-secure-64-character-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Multi-Tenant Storage Backend: 'local' or 's3'
STORAGE_BACKEND=local

# AWS S3 / MinIO Object Storage Configuration (Only required if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_secret_key
S3_BUCKET_NAME=subtitles-private
S3_REGION=us-east-1

# Worker Concurrency & Whisper Engine Limits
# Adjust based on server CPU cores / GPU VRAM
MAX_CONCURRENT_JOBS=3
MAX_QUEUE_SIZE=50
JOB_TIMEOUT_SECONDS=1800

# Whisper Model Configuration
# Models: tiny, base, small, medium, large-v3
DEFAULT_WHISPER_MODEL=base
# Device: 'cpu' or 'cuda' (if NVIDIA GPU with cuDNN available)
WHISPER_DEVICE=cpu
# Compute Type: 'int8', 'float16' (for GPU), 'float32'
WHISPER_COMPUTE_TYPE=int8

# Rate Limiting (SlowAPI)
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_UPLOAD=20/minute

# Storage Paths
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./temp
